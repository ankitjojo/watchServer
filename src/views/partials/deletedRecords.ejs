<%# One "Deleted records" button + full-screen <dialog> per list page (public/js/navigation.js). rows: [{ href?, cells: [] }], columns: [] %>
<%
  var dialogId = 'deleted-records-dialog';
  var title = locals.title || 'Deleted records';
%>
<button type="button" class="button" data-deleted-open="<%= dialogId %>" aria-haspopup="dialog">Deleted records (<%= rows.length %>)</button>
<dialog id="<%= dialogId %>" class="deleted-dialog" aria-labelledby="<%= dialogId %>-title">
  <div class="deleted-dialog-head">
    <h2 id="<%= dialogId %>-title"><%= title %> <span class="muted">(<%= rows.length %>)</span></h2>
    <button type="button" class="button" data-deleted-close aria-label="Close">&times;</button>
  </div>
  <div class="deleted-dialog-body">
    <% if (rows.length === 0) { %>
    <p class="muted">No deleted records</p>
    <% } else { %>
    <div class="table-wrap">
      <table class="table table-hover table-sm align-middle mb-0">
        <thead>
          <tr><% columns.forEach(function (c) { %><th scope="col"><%= c %></th><% }) %></tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
          <tr>
            <% r.cells.forEach(function (cell, i) { %>
            <td><% if (i === 0 && r.href) { %><a href="<%= r.href %>"><%= cell %></a><% } else { %><%= cell %><% } %></td>
            <% }) %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</dialog>
