<% if (rows.length === 0) { %>
<div class="card-body"><p class="text-secondary m-0"><%= locals.emptyText || 'No alerts yet.' %></p></div>
<% } else { %>
<div class="table-responsive table-wrap">
  <table class="table table-vcenter card-table">
    <thead>
      <tr>
        <th scope="col">Created</th><th scope="col">Type</th>
        <% if (locals.showMonitor) { %><th scope="col">Monitor</th><% } %>
        <th scope="col">Email status</th><th scope="col">Recipients</th><th scope="col">Sent</th><th scope="col">Error</th><th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function (a) { %>
      <tr class="<%= a.isFailed ? 'row-failed' : '' %>">
        <td class="text-nowrap text-secondary"><%= a.created %></td>
        <td><%= a.type %></td>
        <% if (locals.showMonitor) { %><td><%= a.monitor %></td><% } %>
        <td><%- include('./statusBadge', { status: a.status, label: a.statusLabel }) %></td>
        <td title="<%= a.recipients %>"><span class="badge bg-secondary-lt"><i class="ti ti-users me-1" aria-hidden="true"></i><%= a.recipientCount %></span></td>
        <td class="text-nowrap text-secondary"><%= a.sent %></td>
        <td class="text-danger small"><%= a.error %></td>
        <td class="text-end">
          <% if (a.canResend) { %>
          <button type="button" class="btn btn-sm btn-outline-danger" data-resend="<%= a.id %>"><i class="ti ti-send me-1" aria-hidden="true"></i>Resend</button>
          <output class="muted small d-block" data-resend-result="<%= a.id %>" aria-live="polite"></output>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
