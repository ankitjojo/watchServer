<%
  var initials = String(currentUser.name || currentUser.email || '?').trim().split(/\s+/).map(function (p) { return p.charAt(0); }).join('').slice(0, 2).toUpperCase();
%>
<header class="navbar navbar-expand-md d-none d-lg-flex d-print-none">
  <div class="container-xl">
    <div class="navbar-nav flex-row order-md-last ms-auto align-items-center">
      <div class="nav-item me-2">
        <button type="button" class="nav-link px-2 border-0 bg-transparent" data-theme-toggle aria-label="Toggle light or dark theme" title="Toggle light or dark theme">
          <i class="ti ti-moon fs-2 hide-theme-dark" aria-hidden="true"></i><i class="ti ti-sun fs-2 hide-theme-light" aria-hidden="true"></i>
        </button>
      </div>
      <div class="nav-item dropdown">
        <button type="button" class="nav-link d-flex lh-1 text-reset p-0 border-0 bg-transparent" data-bs-toggle="dropdown" aria-label="Open user menu" aria-expanded="false">
          <span class="avatar avatar-sm"><%= initials %></span>
          <span class="d-none d-xl-block ps-2 text-start">
            <span class="d-block"><%= currentUser.name %></span>
            <span class="d-block mt-1 small text-secondary"><%= currentUser.role === 'ADMIN' ? 'Admin' : 'Viewer' %></span>
          </span>
        </button>
        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
          <%- include('./userMenu') %>
        </div>
      </div>
    </div>
  </div>
</header>
