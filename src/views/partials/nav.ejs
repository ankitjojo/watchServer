<% if (locals.currentUser) { %>
<%
  const path = locals.currentPath || '';
  const isActive = (href) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
  const link = (href, label) =>
    '<a href="' + href + '"' + (isActive(href) ? ' class="active" aria-current="page"' : '') + '>' + label + '</a>';
%>
<aside class="sidebar">
  <a class="brand" href="/"><%= appName %></a>
  <nav aria-label="Main">
    <%- link('/', 'Overview') %>
    <%- link('/webhook-monitors', 'Webhook monitors') %>
    <%- link('/endpoint-monitors', 'Endpoint monitors') %>
    <%- link('/alerts', 'Alerts') %>
    <% if (currentUser.role === 'ADMIN') { %>
    <%- link('/recipients', 'Recipients') %>
    <%- link('/users', 'Users') %>
    <% } %>
  </nav>
  <form class="inline sidebar-user" method="post" action="/logout">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
    <span class="muted"><%= currentUser.name %> (<%= currentUser.role %>)</span>
    <button type="submit" class="link">Sign out</button>
  </form>
</aside>
<% } else { %>
<header class="topbar"><a class="brand" href="/"><%= appName %></a></header>
<% } %>
