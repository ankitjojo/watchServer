<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="<%= locals.csrfToken || '' %>" />
    <title><%= locals.pageTitle ? pageTitle + ' · ' : '' %><%= appName %></title>
    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/public/css/app.css" />
  </head>
  <body>
    <div class="app-shell<%= locals.currentUser ? ' has-sidebar' : '' %>">
      <%- include('../partials/nav') %>
      <main class="page">
        <%# Back link on every nested page (detail, edit, new). href = parent path (no-JS fallback); navigation.js upgrades it to history.back(). %>
        <% const segments = (locals.currentPath || '').split('/').filter(Boolean); %>
        <% if (locals.currentUser && segments.length > 1) { %>
        <a class="back-link" data-back href="/<%= segments.slice(0, -1).join('/') %>"><span aria-hidden="true">&larr;</span> Back</a>
        <% } %>
        <%- include('../partials/flash') %>
        <%# body is a page template we rendered ourselves (renderPage); it escapes its own values. %>
        <%- body %>
      </main>
    </div>
    <script src="/public/js/api.js" defer></script>
    <script src="/public/js/confirm.js" defer></script>
    <script src="/public/js/navigation.js" defer></script>
    <% (locals.scripts || []).forEach(function (src) { %>
    <script src="<%= src %>" defer></script>
    <% }) %>
  </body>
</html>
