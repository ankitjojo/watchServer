<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Administration</div>
      <h1 class="page-title">Recipients</h1>
      <div class="text-secondary mt-1">Active recipients and all master recipients receive every alert email. Master recipients cannot be deactivated or deleted.</div>
    </div>
    <div class="col-auto ms-auto">
      <a class="btn btn-primary" href="/recipients/new"><i class="ti ti-plus me-1" aria-hidden="true"></i>New recipient</a>
    </div>
  </div>
</div>

<div class="card">
<% if (rows.length === 0) { %>
  <div class="card-body">
    <%- include('../../partials/emptyState', { message: 'No recipients yet.', actionHref: '/recipients/new', actionLabel: 'Add a recipient', icon: 'ti-mail' }) %>
  </div>
<% } else { %>
  <div class="card-header">
    <h2><%= rows.length %> recipient<%= rows.length === 1 ? '' : 's' %></h2>
    <div class="card-actions">
      <div class="input-icon">
        <span class="input-icon-addon"><i class="ti ti-search" aria-hidden="true"></i></span>
        <input type="search" class="form-control form-control-sm" placeholder="Search…" aria-label="Search recipients" data-table-search="recipients" />
      </div>
    </div>
  </div>
  <div class="table-responsive table-wrap">
    <table class="table table-vcenter card-table" id="recipients" data-table-tools>
      <thead>
        <tr><th scope="col" data-sortable>Name</th><th scope="col" data-sortable>Email</th><th scope="col" data-sortable>Type</th><th scope="col" data-sortable>Status</th><th scope="col" class="w-1"><span class="sr-only">Actions</span></th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
        <tr>
          <td class="fw-semibold"><%= r.name %></td>
          <td class="text-secondary"><%= r.email %></td>
          <td><% if (r.isMaster) { %><span class="badge badge-master">Master</span><% } else { %>Normal<% } %></td>
          <td><%- include('../../partials/statusBadge', { status: r.isActive ? 'OK' : 'PAUSED', label: r.isActive ? 'Active' : 'Inactive' }) %></td>
          <td class="text-end actions">
            <%- include('../../partials/rowActions', { label: r.email, editHref: '/recipients/' + r.id + '/edit', deleteAction: r.isMaster ? null : '/recipients/' + r.id + '/delete', confirmText: 'Delete recipient ' + r.email + '?' }) %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="card-body text-secondary m-0" data-table-empty="recipients" hidden>No recipients match your search.</p>
<% } %>
</div>
