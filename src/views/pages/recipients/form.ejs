<h1><%= mode === 'create' ? 'New recipient' : 'Edit recipient' %></h1>
<% if (errors._form) { %><div class="flash flash-error" role="alert"><%= errors._form %></div><% } %>
<form method="post" action="<%= mode === 'create' ? '/recipients/new' : '/recipients/' + id + '/edit' %>" class="card" novalidate>
  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />

  <label for="name">Name</label>
  <input id="name" name="name" type="text" maxlength="100" required value="<%= values.name || '' %>" />
  <%- include('../../partials/fieldError', { field: 'name' }) %>

  <label for="email">Email</label>
  <input id="email" name="email" type="email" maxlength="254" required value="<%= values.email || '' %>" />
  <%- include('../../partials/fieldError', { field: 'email' }) %>

  <% if (isMaster) { %>
  <p><span class="badge badge-master">Master</span> <span class="muted">Master recipients always receive alerts and cannot be deactivated, deleted or demoted.</span></p>
  <input type="hidden" name="type" value="MASTER" />
  <input type="hidden" name="isActive" value="on" />
  <% } else { %>
  <label for="type">Type</label>
  <select id="type" name="type">
    <% types.forEach(function (t) { %>
    <option value="<%= t %>" <%= values.type === t ? 'selected' : '' %>><%= t === 'MASTER' ? 'Master (always receives alerts, cannot be undone)' : 'Normal' %></option>
    <% }) %>
  </select>
  <%- include('../../partials/fieldError', { field: 'type' }) %>

  <label class="checkbox"><input type="checkbox" name="isActive" value="on" <%= values.isActive ? 'checked' : '' %> /> Active (receives alert emails)</label>
  <% } %>

  <div class="form-actions">
    <button type="submit">Save</button>
    <a href="/recipients">Cancel</a>
  </div>
</form>
