<div class="page-head">
  <h1>Endpoint monitors</h1>
  <% if (locals.currentUser && currentUser.role === 'ADMIN') { %><a class="button" href="/endpoint-monitors/new">New endpoint monitor</a><% } %>
</div>
<p class="muted">Each monitor sends an HTTP GET and expects status 200. It is down only when every attempt fails.</p>
<% if (rows.length === 0) { %>
  <% if (locals.currentUser && currentUser.role === 'ADMIN') { %>
<%- include('../../partials/emptyState', { message: 'No endpoint monitors yet.', actionHref: '/endpoint-monitors/new', actionLabel: 'Create the first one' }) %>
  <% } else { %>
<%- include('../../partials/emptyState', { message: 'No endpoint monitors have been set up yet. An admin can create them.' }) %>
  <% } %>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col">Server</th><th scope="col">URL</th><th scope="col">Status</th><th scope="col">Check</th>
        <th scope="col">Retries</th><th scope="col">Last check</th><th scope="col">Next check</th><th scope="col">Last response</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function (m) { %>
      <tr>
        <td><a href="/endpoint-monitors/<%= m.id %>"><%= m.serverName %></a></td>
        <td><%= m.url %></td>
        <td><%- include('../../partials/statusBadge', { status: m.status, label: m.statusLabel }) %></td>
        <td><%= m.checkEvery %></td>
        <td><%= m.retryCount %></td>
        <td><%= m.lastCheck %></td>
        <td><%= m.nextCheck %></td>
        <td><%= m.lastResponse %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
