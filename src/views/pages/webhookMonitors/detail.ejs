<%- include('../../partials/monitorHeader', { title: monitor.name, pretitle: 'Webhook monitor', status: monitor.status, statusLabel: monitor.statusLabel, base: '/webhook-monitors', monitorId: monitor.id, canEdit: can.edit }) %>

<% if (monitor.hasIndexWarning) { %>
<div class="alert alert-warning flash flash-warning" role="status">
  <div class="d-flex">
    <i class="ti ti-alert-triangle alert-icon" aria-hidden="true"></i>
    <div>No index starts with <strong><%= monitor.timestampKey %></strong> on <strong><%= monitor.collection %></strong> (checked when saved), so every check scans the collection. Ask the source backend owners to add one; payMonitor cannot create it.</div>
  </div>
</div>
<% } %>

<div class="row row-cards mb-3">
  <div class="col-lg-<%= can.edit ? '7' : '12' %>">
    <section class="card h-100">
      <div class="card-header"><h2>Configuration</h2></div>
      <div class="card-body">
        <%- include('../../partials/datagrid', { items: [
          { title: 'Payment gateway', value: monitor.gatewayName },
          { title: 'Collection', value: monitor.collection },
          { title: 'Timestamp key', value: monitor.timestampKey },
          { title: 'Check', value: monitor.checkEvery },
          { title: 'Alert when no document for', value: monitor.threshold },
          { title: 'Alert mode', value: monitor.alertMode },
          { title: 'Repeat every', value: monitor.repeatEvery },
          { title: 'Enabled', value: monitor.isEnabled ? 'Yes' : 'No (paused)' },
          { title: 'Last check', value: monitor.lastCheck },
          { title: 'Next check', value: monitor.nextCheck },
          { title: 'Last document age', value: monitor.lastAge },
          { title: 'Created', value: monitor.created },
          { title: 'Updated', value: monitor.updated },
        ] }) %>
      </div>
    </section>
  </div>
  <% if (can.edit) { %>
  <div class="col-lg-5">
    <%- include('../../partials/monitorActionsPanel', { type: 'webhook', monitorId: monitor.id, isEnabled: monitor.isEnabled }) %>
  </div>
  <% } %>
</div>

<%- include('../../partials/monitorExtras', { extras: extras }) %>
