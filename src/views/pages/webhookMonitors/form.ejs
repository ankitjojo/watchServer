<%
  var v = locals.values || {};
  var ci = v.checkInterval || {};
  var th = v.threshold || {};
  var ri = v.repeatInterval || {};
  var isEnabled = v.isEnabled === true || v.isEnabled === 'on' || v.isEnabled === 'true';
  var invalid = function (field) { return errors[field] ? ' is-invalid' : ''; };
  var cancelHref = mode === 'create' ? '/webhook-monitors' : '/webhook-monitors/' + id;
%>
<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Webhook monitors</div>
      <h1 class="page-title"><%= mode === 'create' ? 'New webhook monitor' : 'Edit webhook monitor' %></h1>
    </div>
  </div>
</div>
<% if (errors._form) { %>
<div class="alert alert-danger flash flash-error" role="alert">
  <div class="d-flex"><i class="ti ti-circle-x alert-icon" aria-hidden="true"></i><div><%= errors._form %></div></div>
</div>
<% } %>
<form method="post" action="<%= mode === 'create' ? '/webhook-monitors/new' : '/webhook-monitors/' + id + '/edit' %>" class="card" id="monitor-form" novalidate>
  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label required" for="name">Monitor name</label>
        <input class="form-control<%= invalid('name') %>" id="name" name="name" type="text" maxlength="100" required placeholder="Razorpay webhooks" value="<%= v.name || '' %>" />
        <%- include('../../partials/fieldError', { field: 'name' }) %>
      </div>
      <div class="col-md-6">
        <label class="form-label required" for="gatewayName">Payment gateway name</label>
        <input class="form-control<%= invalid('gatewayName') %>" id="gatewayName" name="gatewayName" type="text" maxlength="60" required placeholder="Razorpay" value="<%= v.gatewayName || '' %>" />
        <%- include('../../partials/fieldError', { field: 'gatewayName' }) %>
      </div>

      <div class="col-md-6">
        <label class="form-label required" for="sourceCollection">Collection (source database)</label>
        <% if (collections.length > 0) { %>
        <select class="form-select<%= invalid('sourceCollection') %>" id="sourceCollection" name="sourceCollection" required>
          <option value="">Choose a collection</option>
          <% collections.forEach(function (c) { %>
          <option value="<%= c %>" <%= v.sourceCollection === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
          <% if (v.sourceCollection && collections.indexOf(v.sourceCollection) === -1) { %>
          <option value="<%= v.sourceCollection %>" selected><%= v.sourceCollection %> (not found)</option>
          <% } %>
        </select>
        <% } else { %>
        <input class="form-control<%= invalid('sourceCollection') %>" id="sourceCollection" name="sourceCollection" type="text" maxlength="120" required value="<%= v.sourceCollection || '' %>" />
        <small class="form-hint muted">The list of collections could not be loaded from the source database, so type the name.</small>
        <% } %>
        <%- include('../../partials/fieldError', { field: 'sourceCollection' }) %>
      </div>
      <div class="col-md-6">
        <label class="form-label required" for="timestampKey">Timestamp key</label>
        <div class="input-group">
          <input class="form-control<%= invalid('timestampKey') %>" id="timestampKey" name="timestampKey" type="text" maxlength="64" required placeholder="dCreatedAt" value="<%= v.timestampKey || '' %>" />
          <button type="button" class="btn" id="validate-key" data-endpoint="/api/v1/source/validate-timestamp-key"><i class="ti ti-circle-check me-1" aria-hidden="true"></i>Validate key</button>
        </div>
        <output id="validate-result" class="form-hint muted d-block" aria-live="polite"></output>
        <%- include('../../partials/fieldError', { field: 'timestampKey' }) %>
      </div>

      <div class="col-md-6">
        <label class="form-label required" for="checkInterval-value">Check every</label>
        <div class="input-group">
          <input class="form-control<%= invalid('checkInterval.value') %>" id="checkInterval-value" name="checkInterval[value]" type="number" min="1" max="10000" required placeholder="10" value="<%= ci.value || '' %>" />
          <select class="form-select" name="checkInterval[unit]" aria-label="Check interval unit">
            <% units.interval.forEach(function (u) { %><option value="<%= u %>" <%= ci.unit === u ? 'selected' : '' %>><%= u.toLowerCase() %></option><% }) %>
          </select>
        </div>
        <small class="form-hint">At most 24 hours.</small>
        <%- include('../../partials/fieldError', { field: 'checkInterval.value' }) %>
        <%- include('../../partials/fieldError', { field: 'checkInterval.unit' }) %>
      </div>
      <div class="col-md-6">
        <label class="form-label required" for="threshold-value">Trigger when no document for</label>
        <div class="input-group">
          <input class="form-control<%= invalid('threshold.value') %>" id="threshold-value" name="threshold[value]" type="number" min="1" max="10000" required placeholder="2" value="<%= th.value || '' %>" />
          <select class="form-select" name="threshold[unit]" aria-label="Threshold unit">
            <% units.threshold.forEach(function (u) { %><option value="<%= u %>" <%= th.unit === u ? 'selected' : '' %>><%= u.toLowerCase() %></option><% }) %>
          </select>
        </div>
        <%- include('../../partials/fieldError', { field: 'threshold.value' }) %>
        <%- include('../../partials/fieldError', { field: 'threshold.unit' }) %>
      </div>

      <div class="col-md-6">
        <label class="form-label" for="alertMode">Alert mode</label>
        <select class="form-select<%= invalid('alertMode') %>" id="alertMode" name="alertMode">
          <% alertModes.forEach(function (m) { %><option value="<%= m.value %>" <%= v.alertMode === m.value ? 'selected' : '' %>><%= m.label %></option><% }) %>
        </select>
        <%- include('../../partials/fieldError', { field: 'alertMode' }) %>
      </div>
      <div class="col-md-6" id="repeat-group" data-show-for="REPEAT_EVERY">
        <label class="form-label" for="repeatInterval-value">Repeat interval</label>
        <div class="input-group">
          <input class="form-control<%= invalid('repeatInterval.value') %>" id="repeatInterval-value" name="repeatInterval[value]" type="number" min="1" max="10000" placeholder="30" value="<%= ri.value || '' %>" />
          <select class="form-select" name="repeatInterval[unit]" aria-label="Repeat interval unit">
            <% units.repeat.forEach(function (u) { %><option value="<%= u %>" <%= ri.unit === u ? 'selected' : '' %>><%= u.toLowerCase() %></option><% }) %>
          </select>
        </div>
        <small class="form-hint">Only for "Repeat every N"; not shorter than the check interval.</small>
        <%- include('../../partials/fieldError', { field: 'repeatInterval.value' }) %>
      </div>

      <div class="col-12">
        <label class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="isEnabled" value="on" <%= isEnabled ? 'checked' : '' %> />
          <span class="form-check-label">Enabled</span>
        </label>
      </div>
    </div>
  </div>
  <div class="card-footer text-end form-actions">
    <div class="btn-list justify-content-end">
      <a href="<%= cancelHref %>" class="btn btn-link">Cancel</a>
      <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1" aria-hidden="true"></i>Save</button>
    </div>
  </div>
</form>
