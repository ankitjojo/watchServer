<% var isAdmin = !!(locals.currentUser && currentUser.role === 'ADMIN'); %>
<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Monitors</div>
      <h1 class="page-title">Webhook monitors</h1>
      <div class="text-secondary mt-1">Each monitor watches one source collection and alerts when no new document arrives within the threshold.</div>
    </div>
    <% if (isAdmin) { %>
    <div class="col-auto ms-auto">
      <a class="btn btn-primary" href="/webhook-monitors/new"><i class="ti ti-plus me-1" aria-hidden="true"></i>New webhook monitor</a>
    </div>
    <% } %>
  </div>
</div>

<div class="card">
<% if (rows.length === 0) { %>
  <div class="card-body">
  <% if (isAdmin) { %>
    <%- include('../../partials/emptyState', { message: 'No webhook monitors yet.', actionHref: '/webhook-monitors/new', actionLabel: 'Create the first one', icon: 'ti-webhook' }) %>
  <% } else { %>
    <%- include('../../partials/emptyState', { message: 'No webhook monitors have been set up yet. An admin can create them.', icon: 'ti-webhook' }) %>
  <% } %>
  </div>
<% } else { %>
  <div class="card-header">
    <h2><%= rows.length %> monitor<%= rows.length === 1 ? '' : 's' %></h2>
    <div class="card-actions">
      <div class="input-icon">
        <span class="input-icon-addon"><i class="ti ti-search" aria-hidden="true"></i></span>
        <input type="search" class="form-control form-control-sm" placeholder="Search…" aria-label="Search webhook monitors" data-table-search="webhook-monitors" />
      </div>
    </div>
  </div>
  <div class="table-responsive table-wrap">
    <table class="table table-vcenter card-table" id="webhook-monitors" data-table-tools>
      <thead>
        <tr>
          <th scope="col" data-sortable>Name</th><th scope="col" data-sortable>Gateway</th><th scope="col" data-sortable>Collection</th><th scope="col" data-sortable>Status</th>
          <th scope="col">Check</th><th scope="col">Threshold</th><th scope="col" data-sortable>Last check</th><th scope="col" data-sortable>Next check</th><th scope="col">Last doc age</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (m) { %>
        <tr>
          <td><a href="/webhook-monitors/<%= m.id %>" class="fw-semibold"><%= m.name %></a></td>
          <td><%= m.gatewayName %></td>
          <td class="text-secondary"><code><%= m.collection %></code></td>
          <td><%- include('../../partials/statusBadge', { status: m.status, label: m.statusLabel }) %></td>
          <td class="text-secondary"><%= m.checkEvery %></td>
          <td class="text-secondary"><%= m.threshold %></td>
          <td class="text-secondary"><%= m.lastCheck %></td>
          <td class="text-secondary"><%= m.nextCheck %></td>
          <td><%= m.lastAge %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="card-body text-secondary m-0" data-table-empty="webhook-monitors" hidden>No monitors match your search.</p>
<% } %>
</div>
