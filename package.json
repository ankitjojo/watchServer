{
  "name": "pay-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "payMonitor: watches the JOJO Subscription Backend 2.0 and emails alerts",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts | pino-pretty",
    "sandbox": "tsx scripts/sandbox/sandbox.ts",
    "sandbox:ctl": "tsx scripts/sandbox/ctl.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "db:indexes": "tsx scripts/ensure-indexes.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit integration",
    "test:acceptance": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects acceptance --runInBand",
    "test:all": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "@tabler/core": "1.7.3",
    "@tabler/icons-webfont": "3.50.0",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.6.1",
    "connect-mongo": "^6.0.0",
    "csrf-sync": "^4.2.1",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.9.0",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  }
}
