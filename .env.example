# payMonitor environment. Copy to .env and fill in. Never commit real values.
# Sandbox mode (npm run sandbox) sets everything itself and needs no .env.

# Product name people see: page title, email subject prefix "[APP_NAME] ...", email footer. Default: payMonitor.
# If you rename it, also change the display name in MAIL_FROM, and update any mail filters that match the subject prefix.
# Alerts already stored keep the old name (their email is rendered when they are created).
APP_NAME=payMonitor
NODE_ENV=development
PORT=3000
TRUST_PROXY=0
LOG_LEVEL=info

# Monitor DB (payMonitor's own database, read/write)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=paymonitor

# Source DB (JOJO subscription backend). Use a MongoDB user with the `read` role ONLY.
SOURCE_MONGO_URI=mongodb://localhost:27017
SOURCE_DB_NAME=replace_me
SOURCE_QUERY_TIMEOUT_MS=10000

# Email. MAIL_TRANSPORT=smtp sends real mail; outbox writes .eml files (dev only).
MAIL_TRANSPORT=smtp
MAIL_OUTBOX_DIR=./.sandbox/outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=abhishek.b@appjojo.in
SMTP_PASS=ouklixejdqdatayk
SMTP_TIMEOUT_MS=15000
MAIL_FROM="payMonitor <abhishek.b@appjojo.in>"

# Session (at least 32 random characters)
SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_MAX_AGE_MS=28800000

# First-run seeds (used only when no user / no master recipient exists yet)
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin@gmail.com123456
MASTER_ALERT_EMAIL=ankitdabhi@appjojo.in
MASTER_ALERT_NAME=Ankit Dabhi

# Base URL used for links inside emails (no trailing slash)
DASHBOARD_BASE_URL=http://localhost:3000

# Endpoint monitors
ENDPOINT_TIMEOUT_MS=10000
ENDPOINT_RETRY_DELAY_MS=5000
ENDPOINT_MAX_REDIRECTS=5
ENDPOINT_MAX_RETRY_COUNT=5
ENDPOINT_DEFAULT_RETRY_COUNT=2
# Failed checks in a row before an ENDPOINT_DOWN alert (1 = alert on the first failed check)
ENDPOINT_DOWN_AFTER_CHECKS=2

# Alerts and email retries (comma-separated minutes; number of values = number of retries)
EMAIL_RETRY_BACKOFF_MIN=1,5,15
SOURCE_ERROR_GROUP_WINDOW_MS=60000
DISPATCHER_POLL_MS=10000
DISPATCHER_LOCK_MS=120000

# Durations and display
DAYS_PER_MONTH=30
MIN_CHECK_INTERVAL_MIN=1
# Largest allowed check interval in minutes (at most 1440 = 24 h)
MAX_CHECK_INTERVAL_MIN=1440
TIMEZONE=Asia/Kolkata

# Rate limits ("<max> per <n> <min|hour>")
LOGIN_RATE_LIMIT=5 per 15 min
ACTION_RATE_LIMIT=10 per 1 min

# Scheduler lease (single active instance) and shutdown
LEASE_TTL_MS=45000
LEASE_RENEW_MS=15000
SHUTDOWN_TIMEOUT_MS=15000
# Max checks running at the same time (protects the Source DB)
SCHEDULER_CONCURRENCY=5
